  "motion": {
    "duration": {
      "120": {
        "$value": "120ms"
      },
      "200": {
        "$value": "200ms"
      },
      "320": {
        "$value": "320ms"
      },
      "600": {
        "$value": "600ms"
      },
      "$type": "duration",
      "press": {
        "$value": "90ms",
        "$description": "Press-in: fast, so the control answers the finger."
      },
      "release": {
        "$value": "280ms",
        "$description": "Release: long enough for the spring overshoot to read."
      },
      "settle": {
        "$value": "420ms",
        "$description": "Layers and indicators coming to rest."
      },
      "micro": {
        "$value": "180ms",
        "$description": "Hover and focus micro-transitions: eased in and out, never snapping."
      },
      "layout": {
        "$value": "560ms",
        "$description": "Layout moves: shared indicators, expanding labels, step changes."
      },
      "reveal": {
        "$value": "700ms",
        "$description": "Scroll-linked reveals and first appearance of a section."
      },
      "stagger": {
        "$value": "45ms",
        "$description": "Delay between siblings in a staggered list."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "settle": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Comes to rest; state changes."
      },
      "enter": {
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$description": "Decelerates in."
      },
      "travel": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$description": "Moves across the screen."
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Accelerates out."
      },
      "glide": {
        "$value": [
          0.22,
          1,
          0.36,
          1
        ],
        "$description": "Long, soft ease-out for layout and reveals."
      },
      "hover": {
        "$value": [
          0.45,
          0,
          0.25,
          1
        ],
        "$description": "Symmetric ease-in-out for hover in and out."
      }
    },
    "spring": {
      "$type": "cubicBezier",
      "$description": "Spring-like curves for direct manipulation. Plain cubic-beziers, so they degrade to 0 ms with the durations.",
      "press": {
        "$value": [
          0.3,
          0,
          0.5,
          1
        ],
        "$description": "Press-in. No overshoot."
      },
      "release": {
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ],
        "$description": "Release. One small overshoot, then rest."
      },
      "settle": {
        "$value": [
          0.22,
          1.24,
          0.36,
          1
        ],
        "$description": "Layers, thumbs and indicators settling into place."
      },
      "layout": {
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Shared-layout moves: quick start, very long settle, no overshoot."
      }
    }
  },
