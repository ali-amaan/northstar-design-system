      "$type": "number",
      "$value": 1.7,
      "$description": "Backdrop saturation behind glass."
    },
    "lift": {
      "$type": "dimension",
      "$value": "-2px",
      "$description": "Hover lift of interactive cards and rows."
    },
    "press": {
      "$type": "number",
      "$value": 0.97,
      "$description": "Scale of a pressed control."
    },
    "spin": {
      "$description": "Motion of the machined spin button finish (the colours are per theme, in material.spin.*).",
      "sweep": {
        "$type": "duration",
        "$value": "700ms",
        "$description": "The light band sliding across on hover and focus. 0ms under reduced motion."
      },
      "sweep-easing": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$description": "Fast start, long settle."
      },
      "turn": {
        "$type": "dimension",
        "$value": "16deg",
        "$description": "How far the conic turns as the pointer crosses the button, end to end."
      },
      "angle": {
        "$type": "dimension",
        "$value": "200deg",
        "$description": "Where the conic sweep starts at rest."
      },
      "press": {
        "$type": "number",
        "$value": 0.985,
        "$description": "Scale of a pressed spin button (it also drops 1px)."
      }
    },
    "liquid": {
      "$description": "Liquid glass: SVG displacement refraction at the rim (Chromium), blur and specular elsewhere. Scales are feDisplacementMap px.",
      "scale": {
        "$type": "number",
        "sm": {
          "$value": 14
        },
        "md": {
          "$value": 28
        },
        "lg": {
          "$value": 44
        }
      },
      "bevel": {
        "$type": "number",
        "$value": 0.16,
        "$description": "Rim width as a fraction of the shorter side."
      },
      "aberration": {
        "$type": "number",
        "$value": 2,
        "$description": "Per-channel scale spread for the colour fringe at the rim."
      },
      "frost": {
        "$type": "dimension",
        "$value": "0.6px",
        "$description": "Blur after refraction."
      },
      "fallback-blur": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Frost where refraction is unavailable (Safari, Firefox)."
      }
    }
  }
