{
  "$description": "Semantic layer, Night theme (the default). A key named 'default' is dropped from the token name: color.signal.default is --ns-color-signal.",
  "color": {
    "$type": "color",
    "ground": { "$value": "{night.0}" },
    "surface": {
      "1": { "$value": "{night.1}" },
      "2": { "$value": "{night.2}" },
      "3": { "$value": "{night.3}" }
    },
    "line": {
      "1": { "$value": "{night.4}" },
      "2": { "$value": "{night.5}" }
    },
    "text": {
      "1": { "$value": "{night.8}" },
      "2": { "$value": "{night.7}" },
      "3": { "$value": "{night.6}" }
    },
    "signal": {
      "default": { "$value": "{glacier.300}", "$description": "Marks and signal text." },
      "fill": { "$value": "{glacier.300}", "$description": "Primary button fill." },
      "wash": { "$value": "{glacier.alpha-12}" },
      "edge": { "$value": "{glacier.300}" }
    },
    "focus": {
      "default": { "$value": "{glacier.300}", "$description": "Focus ring." },
      "halo": { "$value": "transparent" }
    },
    "data": {
      "star": { "$value": "{night.8}" },
      "node": { "$value": "{glacier.300}" },
      "band": { "$value": "{glacier.alpha-35}" },
      "horizon": { "$value": "{glacier.300}" },
      "meridian": { "$value": "{night.5}" },
      "graticule": { "$value": "{night.4}" },
      "likert": {
        "1": { "$value": "{night.5}" },
        "2": { "$value": "{night.6}" },
        "3": { "$value": "{night.7}" },
        "4": { "$value": "{glacier.300}" },
        "5": { "$value": "{glacier.100}" }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Night uses borders only.",
    "1": { "$value": "none" },
    "2": { "$value": "none" },
    "3": { "$value": "none" }
  },
  "material": {
    "$description": "Glass: translucent layered fill, rim highlight, specular sheen and a glacier glow. Components fall back to material.solid when transparency is reduced or backdrop-filter is unsupported.",
    "glass": {
      "$type": "color",
      "fill": { "$value": "rgba(20, 22, 27, 0.4)" },
      "tint": { "$value": "rgba(147, 180, 224, 0.06)", "$description": "Glacier tint layered over the fill." },
      "edge": { "$value": "rgba(232, 234, 238, 0.12)", "$description": "Hairline border of a glass layer." },
      "rim": { "$value": "rgba(255, 255, 255, 0.16)", "$description": "Specular rim on the top edge." },
      "specular": { "$type": "other", "$value": "linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 42%)" }
    },
    "solid": { "$type": "color", "$value": "{night.2}", "$description": "Opaque fallback for glass." },
    "glow": { "$type": "color", "$value": "{glacier.alpha-35}", "$description": "Glacier glow around focused and pressed controls." },
    "spotlight": { "$type": "color", "$value": "rgba(147, 180, 224, 0.16)", "$description": "Pointer-tracked spotlight wash." },
    "shadow": { "$type": "shadow", "$value": "0 24px 48px -12px rgba(0, 0, 0, 0.6)" },
    "hairline": { "$type": "color", "$value": "rgba(232, 234, 238, 0.06)", "$description": "The only border a borderless surface keeps, where separation needs it." },
    "silver": {
      "$description": "Brushed silver: the button finish on liquid glass. hi/lo are the opaque ends of the body gradient (ink is checked against both); signal-hi/lo are the glacier-tinted primary.",
      "hi": { "$type": "color", "$value": "#D3D8DF" },
      "lo": { "$type": "color", "$value": "#8A919C" },
      "signal-hi": { "$type": "color", "$value": "#C9D9EF" },
      "signal-lo": { "$type": "color", "$value": "#7F9DC7" },
      "ink": { "$type": "color", "$value": "{gray.8}", "$description": "Text and icons on silver." },
      "grain": { "$type": "other", "$value": "repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.07) 0 1px, rgba(255, 255, 255, 0) 1px 3px), repeating-linear-gradient(180deg, rgba(6, 8, 12, 0.06) 0 1px, rgba(6, 8, 12, 0) 1px 5px)", "$description": "Fine brushed lines (two coprime periods so the grain does not band)." },
      "sheen": { "$type": "color", "$value": "rgba(255, 255, 255, 0.42)", "$description": "Moving light on the metal." },
      "highlight": { "$type": "color", "$value": "rgba(255, 255, 255, 0.75)", "$description": "Crisp inner top edge." },
      "shade": { "$type": "color", "$value": "rgba(6, 8, 12, 0.28)", "$description": "Inner lower edge of the bevel." },
      "edge": { "$type": "color", "$value": "rgba(6, 8, 12, 0.55)", "$description": "Outer hairline." },
      "shadow": { "$type": "shadow", "$value": "0 1px 1px rgba(0, 0, 0, 0.45), 0 4px 10px -4px rgba(0, 0, 0, 0.6)" }
    },
    "liquid": {
      "$description": "Liquid glass layers: glacier tint, specular highlight, rim, inner glow and drop shadow.",
      "tint": { "$type": "color", "$value": "rgba(147, 180, 224, 0.05)" },
      "highlight": { "$type": "other", "$value": "radial-gradient(120% 80% at 18% 0%, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0) 55%)" },
      "rim": { "$type": "color", "$value": "rgba(255, 255, 255, 0.22)" },
      "rim-low": { "$type": "color", "$value": "rgba(255, 255, 255, 0.06)", "$description": "Lower rim and hairline." },
      "inner": { "$type": "color", "$value": "rgba(255, 255, 255, 0.05)", "$description": "Inner shadow light." },
      "shadow": { "$type": "shadow", "$value": "0 10px 30px -10px rgba(0, 0, 0, 0.55)" }
    }
  }
}
