{
  "$description": "Semantic layer, Day theme.",
  "color": {
    "$type": "color",
    "ground": { "$value": "{gray.0}" },
    "surface": {
      "1": { "$value": "{gray.1}" },
      "2": { "$value": "{gray.2}" },
      "3": { "$value": "{gray.3}" }
    },
    "line": {
      "1": { "$value": "{gray.4}" },
      "2": { "$value": "{gray.5}" }
    },
    "text": {
      "1": { "$value": "{gray.8}" },
      "2": { "$value": "{gray.7}" },
      "3": { "$value": "{gray.6}" }
    },
    "signal": {
      "default": { "$value": "{glacier.700}", "$description": "Marks and signal text." },
      "fill": { "$value": "{glacier.300}", "$description": "Primary button fill." },
      "wash": { "$value": "{glacier.100}" },
      "edge": { "$value": "{glacier.200}" }
    },
    "focus": {
      "default": { "$value": "{glacier.700}", "$description": "Focus ring." },
      "halo": { "$value": "{glacier.alpha-35}" }
    },
    "data": {
      "star": { "$value": "{gray.8}" },
      "node": { "$value": "{glacier.700}" },
      "band": { "$value": "{glacier.alpha-35}" },
      "horizon": { "$value": "{glacier.700}" },
      "meridian": { "$value": "{gray.5}" },
      "graticule": { "$value": "{gray.4}" },
      "likert": {
        "1": { "$value": "{gray.4}" },
        "2": { "$value": "{gray.5}" },
        "3": { "$value": "{glacier.200}" },
        "4": { "$value": "{glacier.300}" },
        "5": { "$value": "{glacier.700}" }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "1": { "$value": "0 1px 2px rgba(6, 8, 12, 0.06)" },
    "2": { "$value": "0 4px 12px rgba(6, 8, 12, 0.08)" },
    "3": { "$value": "0 12px 32px rgba(6, 8, 12, 0.12)" }
  },
  "material": {
    "$description": "Glass: translucent layered fill, rim highlight, specular sheen and a glacier glow. Components fall back to material.solid when transparency is reduced or backdrop-filter is unsupported.",
    "glass": {
      "$type": "color",
      "fill": { "$value": "rgba(255, 255, 255, 0.5)" },
      "tint": { "$value": "rgba(147, 180, 224, 0.08)", "$description": "Glacier tint layered over the fill." },
      "edge": { "$value": "rgba(6, 8, 12, 0.08)", "$description": "Hairline border of a glass layer." },
      "rim": { "$value": "rgba(255, 255, 255, 0.95)", "$description": "Specular rim on the top edge." },
      "specular": { "$type": "other", "$value": "linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0) 46%)" }
    },
    "solid": { "$type": "color", "$value": "{gray.0}", "$description": "Opaque fallback for glass." },
    "glow": { "$type": "color", "$value": "rgba(47, 93, 154, 0.24)", "$description": "Glacier glow around focused and pressed controls." },
    "spotlight": { "$type": "color", "$value": "rgba(47, 93, 154, 0.09)", "$description": "Pointer-tracked spotlight wash." },
    "shadow": { "$type": "shadow", "$value": "0 16px 40px -12px rgba(6, 8, 12, 0.18)" },
    "hairline": { "$type": "color", "$value": "rgba(6, 8, 12, 0.06)", "$description": "The only border a borderless surface keeps, where separation needs it." },
    "silver": {
      "$description": "Brushed silver: the button finish on liquid glass. hi/lo are the opaque ends of the body gradient (ink is checked against both); signal-hi/lo are the glacier-tinted primary.",
      "hi": { "$type": "color", "$value": "#FFFFFF" },
      "lo": { "$type": "color", "$value": "#D3D8DF" },
      "signal-hi": { "$type": "color", "$value": "#F1F6FC" },
      "signal-lo": { "$type": "color", "$value": "#AFC5E5" },
      "ink": { "$type": "color", "$value": "{gray.8}", "$description": "Text and icons on silver." },
      "grain": { "$type": "other", "$value": "repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0 1px, rgba(255, 255, 255, 0) 1px 3px), repeating-linear-gradient(180deg, rgba(6, 8, 12, 0.035) 0 1px, rgba(6, 8, 12, 0) 1px 5px)", "$description": "Fine brushed lines (two coprime periods so the grain does not band)." },
      "sheen": { "$type": "color", "$value": "rgba(255, 255, 255, 0.85)", "$description": "Moving light on the metal." },
      "highlight": { "$type": "color", "$value": "rgba(255, 255, 255, 1)", "$description": "Crisp inner top edge." },
      "shade": { "$type": "color", "$value": "rgba(6, 8, 12, 0.10)", "$description": "Inner lower edge of the bevel." },
      "edge": { "$type": "color", "$value": "rgba(6, 8, 12, 0.16)", "$description": "Outer hairline." },
      "shadow": { "$type": "shadow", "$value": "0 1px 1px rgba(6, 8, 12, 0.10), 0 3px 8px -3px rgba(6, 8, 12, 0.18)" }
    },
    "liquid": {
      "$description": "Liquid glass layers: glacier tint, specular highlight, rim, inner glow and drop shadow.",
      "tint": { "$type": "color", "$value": "rgba(147, 180, 224, 0.10)" },
      "highlight": { "$type": "other", "$value": "radial-gradient(120% 80% at 18% 0%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 60%)" },
      "rim": { "$type": "color", "$value": "rgba(255, 255, 255, 0.95)" },
      "rim-low": { "$type": "color", "$value": "rgba(6, 8, 12, 0.06)", "$description": "Lower rim and hairline." },
      "inner": { "$type": "color", "$value": "rgba(255, 255, 255, 0.5)", "$description": "Inner shadow light." },
      "shadow": { "$type": "shadow", "$value": "0 10px 30px -12px rgba(6, 8, 12, 0.16)" }
    },
    "texture": {
      "$description": "Tactile button texture: fine brushed lines (light and dark, two coprime periods), a soft top highlight and a low inner bevel. signal-* is tuned for the Glacier primary. Text on every textured button body is checked with the lines and highlight composited (tooling/contrast).",
      "$type": "color",
      "light": { "$value": "rgba(255, 255, 255, 0.5)", "$description": "Light brushed line." },
      "dark": { "$value": "rgba(6, 8, 12, 0.03)", "$description": "Dark brushed line." },
      "top": { "$value": "rgba(255, 255, 255, 0.8)", "$description": "Peak of the soft top highlight." },
      "bevel-hi": { "$value": "rgba(255, 255, 255, 0.95)", "$description": "Inner top edge of the bevel." },
      "bevel-lo": { "$value": "rgba(6, 8, 12, 0.08)", "$description": "Inner lower edge of the bevel." },
      "signal-light": { "$value": "rgba(255, 255, 255, 0.12)" },
      "signal-dark": { "$value": "rgba(6, 8, 12, 0.04)" },
      "signal-top": { "$value": "rgba(255, 255, 255, 0.26)" },
      "signal-bevel-hi": { "$value": "rgba(255, 255, 255, 0.6)" },
      "signal-bevel-lo": { "$value": "rgba(6, 8, 12, 0.14)" }
    }
  },
  "backdrop": {
    "$description": "Animated star backdrops (@northstar-js/react/backdrops). Decorative: the stars carry no meaning, but the ground is checked as a ground for text, and ink and signal as marks on it.",
    "ground": { "$type": "color", "$value": "{gray.pale}", "$description": "Backdrop ground." },
    "ink": { "$type": "color", "$value": "{gray.7}", "$description": "Stars." },
    "signal": { "$type": "color", "$value": "{glacier.700}", "$description": "The few Glacier stars, links and the north star." },
    "line": { "$type": "color", "$value": "{gray.5}", "$description": "Rings, meridians and graduations." },
    "faint": { "$type": "color", "$value": "{gray.4}", "$description": "Unlit lattice points and spokes." },
    "glow": {
      "$type": "number",
      "$description": "Peak opacities of the soft glows: nebulae, the orrery core and the interference band.",
      "nebula": { "$value": 0.24 },
      "haze": { "$value": 0.1 },
      "core": { "$value": 0.22 },
      "core-soft": { "$value": 0.07 },
      "band": { "$value": 0.18 }
    }
  }
}
