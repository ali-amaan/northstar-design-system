{
  "name": "@northstar-js/maps",
  "version": "0.1.0",
  "description": "World and country star maps for Northstar: Equal Earth world, LAEA per country, market-status marks, 241 map files per theme.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "NOTICE",
    "data/*LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maps/*": "./dist/maps/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node build/index.cjs",
    "build": "node build/index.cjs && tsc -p tsconfig.build.json",
    "typecheck": "node build/index.cjs --if-missing && tsc -p tsconfig.json --noEmit",
    "test": "node build/index.cjs --if-missing && vitest run"
  },
  "dependencies": {
    "@northstar-js/contracts": "workspace:*",
    "@northstar-js/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
