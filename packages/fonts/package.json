{
  "name": "@northstar-js/fonts",
  "version": "0.1.0",
  "description": "Inter and IBM Plex Mono as WOFF2 (Latin and Latin Extended, 400/500/600) with a font-display: swap stylesheet.",
  "license": "OFL-1.1",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./fonts.css": "./dist/fonts.css",
    "./files/*": "./dist/files/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --verify"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-amaan/northstar-design-system.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://ali-amaan.github.io/northstar-design-system/",
  "bugs": {
    "url": "https://github.com/ali-amaan/northstar-design-system/issues"
  }
}
