{
  "name": "@northstar-js/charts",
  "version": "0.2.0",
  "description": "Star-native figures and data visualisation for Northstar: React SVG components styled by --ns-* CSS variables.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@northstar-js/contracts": "workspace:*",
    "@northstar-js/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-amaan/northstar-design-system.git",
    "directory": "packages/charts"
  },
  "homepage": "https://ali-amaan.github.io/northstar-design-system/",
  "bugs": {
    "url": "https://github.com/ali-amaan/northstar-design-system/issues"
  }
}
