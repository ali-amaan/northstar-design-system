{
  "name": "@northstar-js/react",
  "version": "0.1.0",
  "description": "Northstar basic React components: provider, actions, forms, overlays, layout and data display, styled by --ns-* CSS variables.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./northstar": {
      "types": "./dist/northstar/index.d.ts",
      "import": "./dist/northstar/index.js"
    },
    "./illustrations": {
      "types": "./dist/illustrations/index.d.ts",
      "import": "./dist/illustrations/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./effects.css": "./dist/effects.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@northstar-js/charts": "workspace:*",
    "@northstar-js/contracts": "workspace:*",
    "@northstar-js/icons": "workspace:*",
    "@northstar-js/maps": "workspace:*",
    "@northstar-js/motion": "workspace:*",
    "@northstar-js/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "vitest-axe": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-amaan/northstar-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://ali-amaan.github.io/northstar-design-system/",
  "bugs": {
    "url": "https://github.com/ali-amaan/northstar-design-system/issues"
  }
}
